{
  "name": "anatomy2",
  "version": "1.0.0",
  "description": "\uacb0 GYEOL \u2014 3D anatomy and source-grounded acupoint wiki",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env server/index.mjs\" \"vite\"",
    "build": "node scripts/build-anchors.mjs && node scripts/build-wiki.mjs && tsc && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "models:build": "node scripts/build-models.mjs && node scripts/build-anchors.mjs",
    "wiki:build": "node scripts/build-anchors.mjs && node scripts/build-wiki.mjs",
    "test:production": "node scripts/smoke-production.mjs",
    "test:visual": "node scripts/capture-workspace.mjs",
    "check": "npm test && npm run build && npm run test:e2e && npm run test:production"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "express": "^5.2.1",
    "lucide-react": "^1.42.0",
    "meshoptimizer": "^1.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
